# network_pipeline — environment configuration.
# Copy to `.env` (same directory) and fill in your key(s). The CLI
# autoloads .env from the current working directory on every command.
#
# Minimum for OpenAI-only operation (the recommended default for users
# without Ollama or an Anthropic key):
OPENAI_API_KEY=sk-your-openai-key-here

# Optional — provide either or both to broaden the provider mix.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# OLLAMA_BASE_URL=http://localhost:11434

# Optional — force a specific model profile regardless of which keys
# are present. Valid values: eco | max | test | cloud_eco | cloud_max |
# hybrid | openai_only. When unset, the autopilot picks via
# llm.credentials.auto_profile().
# NETWORK_PIPELINE_PROFILE=openai_only

# Optional — hard cap on cloud spend per engagement (USD).
# NETWORK_PIPELINE_BUDGET_USD=5.00
